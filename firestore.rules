rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ครู/แอดมิน — ต้องตรงกับ TEACHER_EMAILS ใน index.html
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'pitukpong36@gmail.com',
          'pitukpong36@brw.ac.th'
        ];
    }

    // นักเรียนอ่าน/เขียนได้เฉพาะเอกสารของตัวเอง · ครูอ่านได้ทุกคน (แดชบอร์ด)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isTeacher();
    }

    // ยอดผู้เข้าชมเว็บรวม — ใครก็อ่านได้ (แสดงหน้าแรก) · เขียนได้เฉพาะ "บวกทีละ 1"
    match /stats/site {
      allow read: if true;
      allow create: if request.resource.data.count == 1;
      allow update: if request.resource.data.count == resource.data.count + 1
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['count', 'updatedAt']);
    }

    // presence — เจ้าของเขียน/ลบของตัวเองได้ · ผู้ล็อกอินอ่านได้ (ใช้นับ "ออนไลน์")
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
